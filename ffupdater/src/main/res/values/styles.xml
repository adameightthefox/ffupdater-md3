<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Material 3 base theme. On Android 12+ the colors come from the wallpaper (DynamicColors, see FFUpdater.kt),
         on older devices the colorPrimary seed below is used. -->
    <style name="Theme.FFUpdater" parent="@style/Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>

    <!-- same look, but with the system action bar for the activities that still use it -->
    <style name="Theme.FFUpdater.ActionBar" parent="@style/Theme.Material3.DayNight">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>

    <!-- Pure black backgrounds for OLED/AMOLED displays (applied at runtime by AmoledTheme when the dark theme is used).
         The cards stay slightly lighter than the background so that they remain visible. -->
    <style name="ThemeOverlay.FFUpdater.Amoled" parent="">
        <item name="android:colorBackground">#000000</item>
        <item name="android:windowBackground">#000000</item>
        <item name="colorSurface">#000000</item>
        <item name="colorSurfaceDim">#000000</item>
        <item name="colorSurfaceContainerLowest">#000000</item>
        <item name="colorSurfaceContainerLow">#0A0A0A</item>
        <item name="colorSurfaceContainer">#101010</item>
        <item name="colorSurfaceContainerHigh">#161616</item>
        <item name="colorSurfaceContainerHighest">#1C1C1C</item>
    </style>

    <style name="main_activity__theme" parent="@style/Theme.FFUpdater" />

    <style name="crash_report__theme" parent="@style/Theme.Material3.DayNight">
        <item name="colorPrimary">@color/crash_report__error_red</item>
        <item name="colorPrimaryDark">@color/crash_report__error_red</item>
        <item name="colorAccent">@color/crash_report__color_accent</item>
    </style>

    <style name="main_activity__main_title" parent="@style/Widget.Material3.Toolbar">
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
    </style>

    <style name="install_activity__default_text">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="install_activity__button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="install_activity__bold_text" parent="install_activity__default_text">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="install_activity__monospace_text" parent="install_activity__default_text">
        <item name="android:textIsSelectable">true</item>
        <item name="android:fontFamily">monospace</item>
    </style>

    <style name="install_activity__segment">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:visibility">gone</item>
    </style>

</resources>